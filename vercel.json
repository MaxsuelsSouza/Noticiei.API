{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/once",
      "schedule": "0 20 * * *"
    }
  ],
  "fluid": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "includeFiles": "db/migrations/**"
    }
  }
}
