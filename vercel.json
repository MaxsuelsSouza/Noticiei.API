{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/editais",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/editais-10h",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar-11h",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/editais-15h",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar-16h",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/editais-20h",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar-21h",
      "schedule": "0 0 * * *"
    }
  ],
  "fluid": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "includeFiles": "db/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/editais/:rota*",
      "destination": "/api/editais?rota=:rota*"
    }
  ]
}
