{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/editais",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/editais-hoje",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/editais-hoje-2",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/editais-acompanhar-hoje",
      "schedule": "0 15 * * *"
    }
  ],
  "fluid": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "includeFiles": "db/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/editais/:rota*",
      "destination": "/api/editais?rota=:rota*"
    }
  ]
}
