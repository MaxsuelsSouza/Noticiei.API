# Connection string do Neon (Dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/noticiei?sslmode=require

# Chave que o app Android manda no header x-api-key (gere com: openssl rand -hex 32)
APP_API_KEY=

# Segredo do cron da Vercel (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Opcional: app "script" do Reddit (https://www.reddit.com/prefs/apps). Sem isso as fontes do Reddit são ignoradas.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
