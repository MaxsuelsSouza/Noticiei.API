{
  "name": "noticiei-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "daily": "node --env-file-if-exists=.env --import tsx scripts/run-daily.ts",
    "editais": "node --env-file-if-exists=.env --import tsx scripts/run-editais.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "franc-min": "^6.2.0",
    "linkedom": "^0.18.13",
    "rss-parser": "^3.13.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vercel": "^64.7.0"
  }
